# SwiftPM / Xcode
.build/
.swiftpm/
xcuserdata/
*.xcodeproj
*.dSYM
DerivedData/
Package.resolved.orig

# Editors and local tooling (CLAUDE.md is a local working file, never committed)
.vscode/
.claude/
CLAUDE.md
.DS_Store
__pycache__/

# Weights and Metal libraries stay out of the repo (they go to the work area or an override folder)
*.safetensors
*.metallib
/WeightOverride/
# ...except the small files the package ships: the test fixtures and the router's prompts
!/Tests/**/Fixtures/**/*.safetensors
!/Sources/VeilGardeFlywheel/Resources/clip_prompts_v1.safetensors

# The examples' scratch work area (Examples/run.sh)
/Examples/.work/
/Examples/.build/
/Examples/.swiftpm/

# Local only: everything in Docs/ but the site (Docs/site is the documentation), and the maintainer's own scripts,
# which need the research environment, Garde or this Mac's layout
/Docs/*
!/Docs/site/
/Scripts/fixtures/
/Scripts/lib.sh
/Scripts/parity-garde.sh
/Scripts/test.sh
/Scripts/weights.sh

# The site regenerates these: exports and check screenshots
/Docs/site/export/
/Docs/site/.check/
# The ask orb's key, copied from this Mac's ~/.rao by Docs/site/src/askkey.py: never committed
/Docs/site/local/
/docs/site/local/
